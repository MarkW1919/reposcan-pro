# apps/ui/.env.example — Vite UI environment (copy to .env.local to override).
# .env.local is gitignored. All values are optional; the defaults below match a
# standard local run (API on :8000).

# Base URL of the RepoScan API. Default: http://127.0.0.1:8000
# VITE_API_BASE_URL=http://127.0.0.1:8000

# API route prefix. Default: /api/v1
# VITE_API_PREFIX=/api/v1

# Optional API key sent as the X-RepoScan-Api-Key header (only needed when the
# deployment profile has api.security.enabled = true).
# VITE_API_KEY=
