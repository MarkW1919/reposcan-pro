REPOSCAN_ENV=local
REPOSCAN_REGION=us
REPOSCAN_TIMEZONE=America/Los_Angeles

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reposcan
POSTGRES_USER=reposcan
POSTGRES_PASSWORD=reposcan_local

REDIS_HOST=localhost
REDIS_PORT=6379

MEDIA_ROOT=./media
ARTIFACT_ROOT=./artifacts
DATA_ROOT=./data
MODEL_CONFIG_ROOT=./configs/models
CAMERA_CONFIG_ROOT=./configs/cameras

GPS_PROVIDER=mock
HOTLIST_REFRESH_MODE=local
SYNC_ENABLED=false
SYNC_ENDPOINT=
SYNC_API_KEY=

# ── Address Intelligence: Census ACS area demographics (optional) ─────────────
# Enables owner/renter/vacancy context on the Address Intelligence widget.
# The rest of address intelligence (geocoding + dwelling type) works WITHOUT it.
# Get a FREE key (instant, email only — no cost, no card):
#   https://api.census.gov/data/key_signup.html
# Paste it here, then restart the API (npm run api:dev).
CENSUS_API_KEY=

# ── Occupant Intelligence: WhitePages Pro (paid skip-trace) ───────────────────
# Surfaces people associated with a staged destination (names, phones,
# associated people, previous addresses). LICENSED/PAID API — use only for the
# authorized, attorney-reviewed repossession workflow.
#   OCCUPANT_PROVIDER: "whitepages" (paid + free Census fallback) or
#                      "census"/"free" (free address verification only, no paid calls).
#   WHITEPAGES_API_KEY: keep the key ONLY in your local .env (gitignored) —
#                       never in a committed file. Empty key => Census fallback.
# Restart the API after changing these (npm run api:dev).
OCCUPANT_PROVIDER=whitepages
WHITEPAGES_API_KEY=
# Optional: where the 30-day occupant cache lives (gitignored *.sqlite).
OCCUPANT_CACHE_PATH=var/occupant_cache.sqlite

