# deploy/env.example — RepoScan Pro environment configuration template.
#
# Copy this file to /etc/reposcan/env (Linux) or .env (local dev) and fill in
# real values.  Never commit the real file — it contains secrets.
#
# For local development, values here match the defaults in DeploymentConfig so
# no override is needed.  Only set values that differ from the defaults.

# ── Deployment profile ────────────────────────────────────────────────────────
# Matches a filename under configs/deployments/ (without the .yaml extension).
REPOSCAN_DEPLOY_PROFILE=local-dev

# ── API server bind address ───────────────────────────────────────────────────
REPOSCAN_API_HOST=127.0.0.1
REPOSCAN_API_PORT=8000

# ── UI server port ────────────────────────────────────────────────────────────
REPOSCAN_UI_PORT=3000

# ── Postgres connection ───────────────────────────────────────────────────────
# Override here if the postgres URL in the deployment YAML references env vars.
# REPOSCAN_POSTGRES_URL=postgresql://reposcan:CHANGEME@localhost:5432/reposcan

# ── API security ──────────────────────────────────────────────────────────────
# Only required when api.security.enabled = true in the deployment profile.
# REPOSCAN_API_KEY_OPERATOR=CHANGEME_OPERATOR_KEY_MIN_32_CHARS
# REPOSCAN_API_KEY_ADMIN=CHANGEME_ADMIN_KEY_MIN_32_CHARS
# REPOSCAN_API_KEY_INTEGRATOR=CHANGEME_INTEGRATOR_KEY_MIN_32_CHARS

# ── Remote sync ───────────────────────────────────────────────────────────────
# Only required when remote_sync.enabled = true in the deployment profile.
# REPOSCAN_SYNC_API_KEY=CHANGEME_SYNC_KEY

# ── Alert delivery webhook ────────────────────────────────────────────────────
# Only required when alert_delivery.enabled = true.
# REPOSCAN_ALERT_WEBHOOK_KEY=CHANGEME_WEBHOOK_KEY

# ── Watchdog tuning ───────────────────────────────────────────────────────────
WATCHDOG_POLL_INTERVAL=30
WATCHDOG_MAX_FAILURES=3
