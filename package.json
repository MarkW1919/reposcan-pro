{
  "name": "reposcan-pro",
  "version": "0.1.0",
  "private": true,
  "description": "RepoScan Pro monorepo scaffold for edge-first vehicle intelligence.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1",
    "check": "powershell -ExecutionPolicy Bypass -File ./scripts/check.ps1",
    "api:dev": "set PYTHONPATH=packages/contracts/src;apps/api/src;services/alerting/src;services/capture/src;services/inference/src;services/preprocessing/src;services/storage/src;services/sync/src;services/tracking/src && .\\.venv\\Scripts\\python.exe -m uvicorn reposcan_api.main:app --reload",
    "ui:dev": "npm --workspace apps/ui run dev",
    "ui:build": "npm --workspace apps/ui run build"
  }
}
